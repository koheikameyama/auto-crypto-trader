# ローカル daily-live-run.sh 用の環境変数テンプレート
# これを ~/.config/auto-crypto-trader/env にコピーして値を埋める:
#
#   mkdir -p ~/.config/auto-crypto-trader
#   cp .env.live.example ~/.config/auto-crypto-trader/env
#   chmod 600 ~/.config/auto-crypto-trader/env
#   # あとはエディタで開いて値を設定
#
# このファイル自体は値なし、commit OK

# Slack Incoming Webhook URL.
# 作り方: https://api.slack.com/apps → New App → Incoming Webhooks → Add Webhook to Workspace → channel 選択 → URL コピー
SLACK_WEBHOOK_URL=
