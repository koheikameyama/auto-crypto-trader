generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Asset {
  id             String          @id @default(cuid())
  symbol         String          @unique
  yfinanceTicker String          @unique
  feeRate        Float
  dailyBars      DailyBar[]
  trades         Trade[]
  onchainMetrics OnchainMetric[]
}

model OnchainMetric {
  id         String   @id @default(cuid())
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id])
  date       DateTime
  priceUsd   Float
  capMrktUsd Float
  txCnt      Int
  adrActCnt  Int

  @@unique([assetId, date])
  @@index([assetId, date])
}

model FundingRate {
  id      String   @id @default(cuid())
  symbol  String
  date    DateTime
  avgRate Float
  count   Int

  @@unique([symbol, date])
  @@index([symbol, date])
}

model MacroBar {
  id     String   @id @default(cuid())
  ticker String
  date   DateTime
  open   Float
  high   Float
  low    Float
  close  Float
  volume Float?

  @@unique([ticker, date])
  @@index([ticker, date])
}

model LivePositionLog {
  id               String   @id @default(cuid())
  asset            String
  date             DateTime
  dxyValue         Float
  dxyScore         Float
  fundingValue     Float
  fundingScore     Float
  targetPosition   Float
  previousPosition Float?
  rebalanceFlag    Boolean
  notes            String?
  createdAt        DateTime @default(now())

  @@unique([asset, date])
  @@index([asset, date])
}

model VirtualPortfolioState {
  id               String   @id @default(cuid())
  asset            String
  date             DateTime
  price            Float
  targetPosition   Float
  actualPosition   Float
  cashUsd          Float
  units            Float
  equityUsd        Float
  rebalancedToday  Boolean
  rebalanceDelta   Float
  feeUsd           Float
  cumulativeReturn Float
  cumulativeFee    Float
  createdAt        DateTime @default(now())

  @@unique([asset, date])
  @@index([asset, date])
}

model DepositEvent {
  id        String   @id @default(cuid())
  asset     String
  date      DateTime
  amountJpy Float
  notes     String?
  createdAt DateTime @default(now())

  @@unique([asset, date])
  @@index([asset, date])
}

model ActualPortfolioState {
  id               String   @id @default(cuid())
  asset            String
  date             DateTime
  price            Float
  targetPosition   Float
  actualPosition   Float
  cashJpy          Float
  units            Float
  equityJpy        Float
  rebalancedToday  Boolean
  rebalanceDelta   Float
  feeJpy           Float
  slippageBps      Float
  cumulativeReturn Float
  cumulativeFeeJpy Float
  depositJpy       Float    @default(0)
  skipReason       String?
  createdAt        DateTime @default(now())

  @@unique([asset, date])
  @@index([asset, date])
}

model OrderLog {
  id             String    @id @default(cuid())
  asset          String
  date           DateTime
  side           String
  orderType      String
  requestedUnits Float
  execUnits      Float?
  requestedPrice Float?
  execPrice      Float?
  feeJpy         Float?
  orderId        String?
  status         String
  errorMessage   String?
  submittedAt    DateTime
  filledAt       DateTime?
  rawResponse    Json?

  @@index([asset, date])
  @@index([status, submittedAt])
}

model DailyBar {
  id      String   @id @default(cuid())
  assetId String
  asset   Asset    @relation(fields: [assetId], references: [id])
  date    DateTime
  open    Float
  high    Float
  low     Float
  close   Float
  volume  Float?

  @@unique([assetId, date])
  @@index([assetId, date])
}

model BacktestRun {
  id             String   @id @default(cuid())
  strategy       String
  assetSymbol    String?
  startDate      DateTime
  endDate        DateTime
  initialCapital Float
  params         Json
  totalReturn    Float
  sharpe         Float
  mar            Float
  profitFactor   Float
  maxDrawdown    Float
  winRate        Float
  tradeCount     Int
  expectancy     Float
  createdAt      DateTime @default(now())
  trades         Trade[]
  reportPath     String?

  @@index([strategy, assetSymbol, createdAt])
}

model WalkForwardRun {
  id              String   @id @default(cuid())
  strategy        String
  assetSymbol     String
  startDate       DateTime
  endDate         DateTime
  isDays          Int
  oosDays         Int
  stepDays        Int
  oosAvgSharpe    Float
  oosAvgMar       Float
  oosAvgPf        Float
  oosMaxDd        Float
  isOosSharpeDrop Float
  passed          Boolean
  windows         Json
  createdAt       DateTime @default(now())
  reportPath      String?

  @@index([strategy, assetSymbol, createdAt])
}

model Trade {
  id            String      @id @default(cuid())
  backtestRunId String
  backtestRun   BacktestRun @relation(fields: [backtestRunId], references: [id])
  assetId       String
  asset         Asset       @relation(fields: [assetId], references: [id])
  strategy      String
  side          String
  entryDate     DateTime
  entryPrice    Float
  exitDate      DateTime?
  exitPrice     Float?
  exitReason    String?
  sizeUnits     Float
  pnlUsd        Float?
  holdingDays   Int?

  @@index([backtestRunId])
  @@index([assetId, entryDate])
}
